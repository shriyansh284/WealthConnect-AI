# For local development: either set GEMINI_API_KEY here (not recommended)
# or rely on Google Cloud Secret Manager and set GCP_PROJECT_ID.

# Gemini API Key (leave empty and use Secret Manager in production)
GEMINI_API_KEY=

# Gemini Model to use
GEMINI_MODEL=gemini-2.5-pro

# GCP Project ID for Secret Manager access
GCP_PROJECT_ID=your-gcp-project-id

# CORS allowed origins (comma-separated for multiple origins)
# CORS_ALLOW_ORIGINS=*
